# Cached HACS tarballs (160M, regenerable via hacs_api_surface.py)
.hacs_cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Spike scratch
*.log
# ...but v2's experiment logs are evidence, cited by the report. Until 2026-10-04 this rule
# silently kept 100 of them out of every commit, including ones a commit message said it added.
!v2/experiments/**/*.log

# Spike run artefacts
spike/audit/

# Generator + analytics caches (regenerable, and pinned by HA_VERSION)
spike/.ha_source_cache/
spike/.ha_analytics.json

# Real-HA spike: instance config and credentials — never commit the token
spike/.ha_config/
spike/.ha_token

# v2: cached telemetry snapshot (regenerable via figures/ecosystem_scale.py)
# (v2/figures/custom_integrations.json was ignored here until 2026-10-06: it is the raw input of
# Chapter 1's figures, and the live source has moved since, so it is committed — finding F37)

# Windows download markers (WSL)
*:Zone.Identifier

# F59: an integration's kept .storage, by default under its config root (supervise.py --keep-dir)
v2/experiments/**/confine/kept/

# Local working files, never committed (2026-10-25 cleanup): the AI tool's settings and the
# agent's working state, the working plan and method notes, and copies of cited papers, which
# are other people's copyright.
.claude/
v2/STATE.md
v2/00_METHOD.md
v2/01_PLAN.md
v2/refs/

# The final report: sources tracked (2026-11-08); built documents and caches not
v2/submission/*.docx
v2/submission/*.pdf
v2/submission/__pycache__/

# The working report and the proposal: kept locally, not published (2026-11-08)
v2/report/
v2/proposal/

# Course deliverables, submitted separately (2026-10-25)
v2/interim/
v2/Diary1.docx
v2/Diary2.docx
