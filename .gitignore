# Cached HACS tarballs (160M, regenerable via hacs_api_surface.py)
.hacs_cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Spike scratch
*.log
# ...but v2's experiment logs are evidence, cited by the report. Until 2026-10-04 this rule
# silently kept 100 of them out of every commit, including ones a commit message said it added.
!v2/experiments/**/*.log

# Spike run artefacts
spike/audit/

# Generator + analytics caches (regenerable, and pinned by HA_VERSION)
spike/.ha_source_cache/
spike/.ha_analytics.json

# Real-HA spike: instance config and credentials — never commit the token
spike/.ha_config/
spike/.ha_token

# v2: cached telemetry snapshot (regenerable via figures/ecosystem_scale.py)
# (v2/figures/custom_integrations.json was ignored here until 2026-10-06: it is the raw input of
# Chapter 1's figures, and the live source has moved since, so it is committed — finding F37)

# Windows download markers (WSL)
*:Zone.Identifier
